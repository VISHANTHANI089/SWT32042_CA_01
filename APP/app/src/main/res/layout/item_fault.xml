<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F8F6F0"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="16dp">

    <!-- Fault Title -->
    <TextView
        android:id="@+id/ItemTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Router Connection Loss"
        android:textColor="#89140D"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Location & Device Info -->
    <TextView
        android:id="@+id/ItemDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Location: Server Room 3B | Device: Cisco Switch"
        android:textColor="#89140D"
        android:textSize="13sp"
        android:layout_marginTop="4dp" />

    <!-- Priority Badge -->
    <TextView
        android:id="@+id/ItemPriority"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Priority: High"
        android:textColor="#FF5252"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <!-- Horizontal Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Edit Button -->
        <Button
            android:id="@+id/EditFault"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="Edit"
            android:textColor="#FFFFFF"
            android:backgroundTint="#424242"
            android:layout_marginEnd="8dp" />

        <!-- Delete / Resolve Button -->
        <Button
            android:id="@+id/DeleteFault"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="Delete"
            android:textColor="#FFFFFF"
            android:backgroundTint="#89140D" />

    </LinearLayout>

</LinearLayout>