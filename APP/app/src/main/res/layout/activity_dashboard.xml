<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F6F0"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header PART-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Horizontal layout to  Icon and App Name side by side -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/p1_logo"
                    android:layout_marginStart="-25dp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FaultTrack"
                    android:textColor="#4D0404"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginStart="-20dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textColor="#4D0404"
                android:textStyle="bold"
                android:textSize="24sp" />
        </LinearLayout>

    </LinearLayout>

    <!--   system overview -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#1A1A1A"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYSTEM STATUS OVERVIEW"
            android:textColor="#F8F6F0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Actve Faults"
            android:textColor="#F8F6F0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/TotalFaultCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#D32F2F"
            android:textSize="44sp"
            android:textStyle="bold"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="unresolved Faults"
            android:textColor="#9E9E9E"
            android:textSize="15sp" />


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A2A"
            android:layout_marginBottom="16dp" />

        <!--        priority showing -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/HighPriorityCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#221212"
                android:padding="12dp"
                android:text="0 High Priority"
                android:textColor="#FF5252"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/MediumLowCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#1E1E1E"
                android:padding="12dp"
                android:text="0 Medium/Low"
                android:textColor="#FFB74D"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <!-- QUICK ACTIONS PART -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="QUICK ACTIONS"
        android:textColor="#4D0404"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:layout_marginBottom="12dp" />

    <!-- Add New Fault Card USING linear layout  -->
    <LinearLayout
        android:id="@+id/AddFault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#4D0404"
        android:orientation="vertical"
        android:padding="18dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add New Fault"
            android:textColor="#F8F6F0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Report router, switch or link error"
            android:textColor="#F8F6F0"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- View & Manage Faults Card/Button -->
    <LinearLayout
        android:id="@+id/ViewFaults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="#4D0404"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="View  Manage Faults"

            android:textColor="#F8F6F0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit or resolve logged incidents"
            android:textColor="#F8F6F0"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>